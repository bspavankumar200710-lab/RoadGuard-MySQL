rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(request.resource.data);
      allow delete: if false;
    }

    // Road hazards and vehicle speed detections
    function isValidRoadHazard(data) {
      return data.keys().hasAll(['id', 'type', 'confidence', 'severity', 'description', 'timestamp'])
        && data.id is string && data.id.size() <= 128
        && data.type is string && data.type.size() <= 64
        && data.confidence is number
        && data.severity is string && data.severity.size() <= 32
        && data.description is string && data.description.size() <= 1000
        && data.timestamp is string && data.timestamp.size() <= 64;
    }

    match /detections/{detectionId} {
      // Public safety and navigation read access
      allow read: if true;

      // Create allowed with valid schema; if userId is specified, ensure it belongs to the authenticated user
      allow create: if isValidRoadHazard(request.resource.data)
        && (!('userId' in request.resource.data) || request.resource.data.userId == null || (isSignedIn() && request.resource.data.userId == request.auth.uid));

      // Prevent users from overwriting other users' reports
      allow update: if isValidRoadHazard(request.resource.data)
        && (
          // Owner can update their report
          (isSignedIn() && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
          // Community verification review
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verifiedStatus', 'verificationStatus', 'verifiedAt', 'verifiedBy', 'learnedAccuracyScore', 'disputeReason', 'aiLearningFeedbackSent'])) ||
          // Anonymous or legacy report without ownership
          (!('userId' in resource.data) || resource.data.userId == null)
        );

      // Prevent users from deleting other users' reports
      allow delete: if (isSignedIn() && 'userId' in resource.data && resource.data.userId == request.auth.uid)
        || (!('userId' in resource.data) || resource.data.userId == null);
    }

    match /agentLearnings/{learningId} {
      allow read, write: if true;
    }
  }
}
